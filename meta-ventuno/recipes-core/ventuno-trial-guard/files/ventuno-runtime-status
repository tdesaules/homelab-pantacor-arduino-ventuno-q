#!/bin/sh
set -eu
read -r pid < /run/ventuno-runtime.pid
case "$pid" in ''|*[!0-9]*) exit 2 ;; esac
base="/proc/$pid/root"
socket="$base/run/pantavisor/pv/pv-ctrl"
lock=/run/ventuno-runtime-query.lock
attempt=0
until mkdir "$lock" 2>/dev/null; do
    attempt=$((attempt + 1))
    [ "$attempt" -le 5 ] || exit 3
    sleep 1
done
trap 'rm -rf "$lock"' EXIT
case "${1:-status}" in
    restart|stop) pvcontrol -s "$socket" containers "$1" diagnostic; exit ;;
    status) ;;
    *) exit 2 ;;
esac
echo '### Pantavisor containers'
pvcontrol -s "$socket" containers ls
echo '### Current revision'
pvcontrol -s "$socket" steps get current
echo '### Revision progress'
pvcontrol -s "$socket" steps show-progress current
echo '### Persistent application data'
data="$base/storage/disks/perm/diagnostic/data"
if [ -f /etc/ventuno-app-storage.conf ]; then data="$base/mnt/appdata/perm/diagnostic/data"; fi
cat "$data/boots" "$data/heartbeat.json"
